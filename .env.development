# Local development API (ASP.NET Core via Visual Studio, http profile = port 5272).
# Host only — the API client appends /api/v1. Loaded by `expo start` (mode=development).
#
# NOTE: a PHYSICAL device cannot reach "localhost" (that's the PC). On a Wi-Fi device use your
# PC's LAN IP instead, e.g. EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:5272
# "localhost" works on an Android emulator (via 10.0.2.2) or with `adb reverse tcp:5272 tcp:5272`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5272
EXPO_PUBLIC_ONESIGNAL_APP_ID=c31cd751-3421-4582-8ba8-0f2a236398b5
EXPO_PUBLIC_DEVICE_REGISTER_PATH=/api/v1/devices
