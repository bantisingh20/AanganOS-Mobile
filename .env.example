# AanganOS app environment. API base is HOST ONLY (the client appends /api/v1). Nothing hardcoded in source.
#
# Env file loading (Expo):
#   .env               loaded in every mode
#   .env.development   `expo start`                 -> local API (Visual Studio, port 5272)
#   .env.production    production builds             -> production API
#   .env.local         personal overrides (gitignored)
# NOTE: all .env* except this .env.example are gitignored for this repo.
#
# Local dev (Visual Studio http profile on port 5272). A physical Wi-Fi device must use the
# PC's LAN IP (e.g. http://192.168.1.5:5272), NOT localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5272
EXPO_PUBLIC_ONESIGNAL_APP_ID=c31cd751-3421-4582-8ba8-0f2a236398b5
EXPO_PUBLIC_DEVICE_REGISTER_PATH=/api/v1/devices

# Production value:
# EXPO_PUBLIC_API_BASE_URL=https://aanganosapi.sharcnix.com
